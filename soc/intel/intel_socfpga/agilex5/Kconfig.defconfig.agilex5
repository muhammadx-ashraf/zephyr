if SOC_AGILEX5

# must be >= the highest interrupt number used
# - include the UART interrupts 173 or 274
config NUM_IRQS
	default 274

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 400000000

config KERNEL_VM_SIZE
	default 0x400000

# Default ARM64_VA_BITS=32 leaves MAX_XLAT_TABLES at 8; Agilex5 maps many
# MMIO windows (UART, GIC, USB, SD, eth, ...) and runs out during device_map().
config MAX_XLAT_TABLES
	default 24
endif
